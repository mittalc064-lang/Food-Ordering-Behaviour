            <column caption='select measure' datatype='integer' name='[Calculation_0886234438848523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 0886234437083143] = &quot;Revenue&quot; THEN&#13;&#10;    [order_value]&#13;&#10;ELSE&#13;&#10;    1&#13;&#10;END' />
